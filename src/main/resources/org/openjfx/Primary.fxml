<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" prefHeight="508.0" prefWidth="582.0" spacing="0.0" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.controller.PrimaryController">

    <HBox alignment="CENTER" prefHeight="60.0" styleClass="weird-band">
        <Label styleClass="hieroglyphs" text="𓀬 𓁇 𓁣 𓁿 𓆣 𓆦 𓄿 𓅓 𓆣 𓁿" />
    </HBox>

    <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="40.0" left="20.0" right="20.0" top="40.0" />
        </padding>
        <children>
            <Button mnemonicParsing="false" onAction="#beginGame" prefHeight="60.0" prefWidth="250.0" text="NUOVA PARTITA" />
            <Button disable="true" mnemonicParsing="false" text="CARICA PARTITA" prefHeight="40.0" prefWidth="250.0" />
            <Button disable="true" mnemonicParsing="false" onAction="#goToSettings" prefHeight="40.0" prefWidth="250.0" text="IMPOSTAZIONI" />
        </children>
    </VBox>

    <HBox alignment="CENTER_LEFT" prefHeight="40.0" styleClass="weird-band">
        <Label styleClass="hieroglyphs" text=" ▓▓▒▒░░ GORBINO'S GAME OF CHOICE ░░▒▒▓▓" />
    </HBox>

</VBox>