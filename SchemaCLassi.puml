@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true

package "Model" {
    enum Color {
        RED
        YELLOW
        GREEN
        BLUE
        WILD
    }
    enum CardType {
        NUMBERS
        SKIP
        REVERSE
        DRAW_TWO
        WILD_JOLLY
        WILD_DRAW
    }
    enum BotType {
        STUPID
        CLEVER
        CHEEKY
    }

    class Card <<Serializable>> {
        - color: Color
        - type: CardType
        - value: int
        + isPlayableOn(topCard: Card): boolean
    }

    abstract class Player <<Serializable>> {
        # name: String
        - hand: List<Card>
        - hasCalledUno: boolean
        + receiveCard(c: Card)
        + removeCard(c: Card)
        + hasUno(): boolean
    }

    class HumanPlayer extends Player {}
    class BotPlayer extends Player {
        - personality: BotType
        + BotPlays(current: Card): Card
        + chooseColor(current: Color): Color
        + wantsToChallenge(): boolean
    }

    class GameState <<Serializable>> {
        + drawPile: Stack<Card>
        + discardPile: Stack<Card>
        + players: List<Player>
        + currentPlayerIndex: int
        + currentColor: Color
        + getTopCards(nCards: int): Stack<Card>
        + reshuffleDiscardIntoDraw()
    }

    interface GameMode {
        + isMatchOver(state: GameState): boolean
    }
    class ClassicGame implements GameMode {}
    class ScoreBasedGame implements GameMode {}
}

package "Stats & Settings" {
    class MatchSettings <<Serializable>> {}
    class MatchStats <<Serializable>> {}
    class PlayerStats <<Serializable>> {}
    class GameStats <<Singleton>> {
        - instance: GameStats
        + getInstance(): GameStats
    }
}

package "Engine (Presenter)" {
    class GameEngine {
        - state: GameState
        - view: GameView
        - settings: MatchSettings
        + startGame()
        + startTurn()
        + executeMove(player: Player, chosenCard: Card)
        + runSimulation(numSimulations: int)
    }
}

package "View & Controller" {
    interface GameView {
        + updateTopCard(topCard: Card)
        + updatePlayerHand(hand: List<Card>)
        + showMessage(msg: String)
    }
    class TavoloController implements GameView {
        - engine: GameEngine
        + setInitialData(settings: MatchSettings)
    }
    class SetupController {}
}

package "Utils" {
    class SaveManager {
        + saveGame(state: GameState, filename: String): boolean
        + loadGame(filename: String): GameState
    }
    class ExportManager {
        + exportStatsToJson(stats: GameStats): boolean
    }
}

GameEngine "1" o-- "1" GameState
GameEngine "1" o-- "1" GameView
GameState "1" *-- "*" Player
Player "1" *-- "*" Card
BotPlayer o-- BotType
Card "1" *-- "1" Color
@enduml